# Todos kept in a `State`, for tests. A service runs one launch for each request, so a state set
# up inside the service would start empty every time.

import Std.State.{State}
import Domain.Todo.{Todo, TodoId, TodoStore, TodoNotFound}
import Domain.Todo

pub type Memory(todos: List[Todo], next: Int)

pub fn empty() -> Memory {
  Memory(todos: [], next: 1)
}

pub handler MemoryTodos: TodoStore {
  fn next_id() {
    state <- State[Memory]
    memory = state.get()
    state.set(Memory(next: memory.next + 1, ..memory))
    Todo.numbered(memory.next)
  }

  fn find(id) {
    state <- State[Memory]
    state.get().todos.find(|t| t.id == id).or_fail(TodoNotFound(id:))
  }

  fn all() {
    state <- State[Memory]
    state.get().todos
  }

  fn save(todo) {
    state <- State[Memory]
    state.update(|m| {
      others = m.todos.filter(|t| t.id != todo.id)
      Memory(todos: others.append([todo]), ..m)
    })
  }

  fn remove(id) {
    state <- State[Memory]
    memory = state.get()
    if memory.todos.any(|t| t.id == id) {
      state.set(Memory(todos: memory.todos.filter(|t| t.id != id), ..memory))
    } else {
      fail TodoNotFound(id:)
    }
  }
}
