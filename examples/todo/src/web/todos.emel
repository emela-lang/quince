# The HTTP API of todos: what the requests and responses hold, and the controllers that turn them
# into domain values and back. Only this module knows the paths and the JSON.

import Std.Http.Request.{Post}
import Std.Dynamic.{Decode, Encode}
import Std.Shape.{Shaped}
import Quince.{Api, InvalidInput, HttpError}
import Domain.Todo.{Todo, TodoStore, TodoNotFound}
import Domain.Todo
import Usecase.Todos

type TodoPath(id: String) derive Decode, Shaped

type ListQuery(done: Option[Bool]) derive Decode, Shaped

type TodoBody(title: String) derive Decode, Shaped

type CreateTodo(body: TodoBody) derive Decode, Shaped

type RenameTodo(id: String, body: TodoBody) derive Decode, Shaped

type TodoView(id: String, title: String, done: Bool) derive Encode

pub fn api() -> Api[TodoStore] {
  Quince.new()
    |> Quince.get("/todos", list)
    |> Quince.route(Post, "/todos", 201, create)
    |> Quince.get("/todos/:id", show)
    |> Quince.patch("/todos/:id", rename)
    |> Quince.post("/todos/:id/complete", complete)
    |> Quince.delete("/todos/:id", remove)
}

fn list(input: ListQuery) -> List[TodoView] uses { TodoStore } {
  Todos.list(input.done).map(view)
}

fn create(input: CreateTodo) -> TodoView fails InvalidInput uses { TodoStore } {
  title = Quince.field("title", || Todo.title(input.body.title))
  view(Todos.create(title))
}

fn show(input: TodoPath) -> TodoView fails InvalidInput | HttpError uses { TodoStore } {
  view(Todos.get(id(input.id))) escape {
    TodoNotFound(..) -> fail not_found()
  }
}

fn rename(input: RenameTodo) -> TodoView fails InvalidInput | HttpError uses { TodoStore } {
  title = Quince.field("title", || Todo.title(input.body.title))
  view(Todos.rename(id(input.id), title)) escape {
    TodoNotFound(..) -> fail not_found()
  }
}

fn complete(input: TodoPath) -> TodoView fails InvalidInput | HttpError uses { TodoStore } {
  view(Todos.complete(id(input.id))) escape {
    TodoNotFound(..) -> fail not_found()
  }
}

fn remove(input: TodoPath) -> () fails InvalidInput | HttpError uses { TodoStore } {
  Todos.remove(id(input.id)) escape {
    TodoNotFound(..) -> fail not_found()
  }
}

fn not_found() -> HttpError {
  HttpError(status: 404, title: "todo not found")
}

fn id(text: String) -> Todo.TodoId fails InvalidInput {
  Quince.field("id", || Todo.todo_id(text))
}

fn view(todo: Todo) -> TodoView {
  TodoView(id: Todo.id_text(todo.id), title: Todo.title_text(todo.title), done: todo.done)
}
