-- Response builders for quince (spec 0046 HTTP server). Every function here is
-- pure (`uses {}`): it only shapes the `Response` record from `std.http`. The
-- `|>`-friendly forms take a `Response` as their first argument so a handler can
-- read top-to-bottom: `ok("hi") |> header("content-type", "text/plain")`.

module response

import std.http
import brix.assert

-- 200 OK with a plain body and no headers.
pub fn ok(body: String) -> Response uses {} {
    Response { status: 200  headers: []  body: body }
}

-- Any status with a plain body and no headers.
pub fn text(code: Int, body: String) -> Response uses {} {
    Response { status: code  headers: []  body: body }
}

-- 404 with a default body.
pub fn not_found() -> Response uses {} {
    Response { status: 404  headers: []  body: "not found\n" }
}

-- `|>` form: override the status, keeping headers and body.
pub fn status(res: Response, code: Int) -> Response uses {} {
    Response { status: code  headers: res.headers  body: res.body }
}

-- `|>` form: append one header, keeping status and body.
pub fn header(res: Response, name: String, value: String) -> Response uses {} {
    Response {
        status: res.status
        headers: array_push(res.headers, Header { name: name  value: value })
        body: res.body
    }
}

@test
fn ok_is_200() -> Unit uses {} {
    let r = ok("hi")
    assert.eq(r.status, 200)
    assert.eq(r.body, "hi")
}

@test
fn text_sets_status_and_body() -> Unit uses {} {
    let r = text(201, "made")
    assert.eq(r.status, 201)
    assert.eq(r.body, "made")
}

@test
fn status_overrides_only_the_code() -> Unit uses {} {
    let r = ok("x") |> status(418)
    assert.eq(r.status, 418)
    assert.eq(r.body, "x")
}

@test
fn header_appends_one_header() -> Unit uses {} {
    let r = ok("x") |> header("content-type", "text/plain")
    assert.eq(array_length(r.headers), 1)
}
