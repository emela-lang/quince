# An HTTP API as a list of routes. A route is a method, a pattern and a handler from one input
# type to one output type: quince reads the input from the request, calls the handler and writes
# its output as JSON.
#
# ```emela
# type TodoPath(id: String)
#
# fn api() -> Api[TodoNotFound, { TodoStore }] {
#   Quince.new() |> Quince.get("/todos/:id", show) |> Quince.post("/todos", create)
# }
#
# @entry(Http.serve)
# pub fn app(request: Request) -> Response {
#   with MemoryTodos { Quince.handle(api(), request, on_error) }
# }
# ```
#
# - The input type is a record. A field named like a parameter of the pattern (`:id`) is read
#   from the path, a field named `body` from the JSON body, and every other field from the query.
#   Input that cannot be read is answered with 400 (`InvalidInput`), listing every field at fault
# - The errors of the handlers (E) go to `on_error`, which turns them into responses with
#   `escape`, so that none is left out
# - A path that no route matches is answered with 404, and a method that no route of the path
#   takes with 405 and `allow`. HEAD runs the GET route without its body, and OPTIONS is answered
#   with 204 and `allow`

import Std.Http.Request.{Request, Method, Get, Head, Post, Put, Patch, Delete, Options}
import Std.Http.Response.{Response}
import Dynamic.{Dynamic, Decode, Encode, DecodeError, DecodeErrors, Key, Index}
import Shape.{Shape, Shaped}
import Shape.Rule.{Broken, AllBroken}
import Json.{SyntaxError}
import Pattern.{Pattern}
import Input

## Input that cannot be read, by field. `handle` answers it with 400 and the problems, without
## calling `on_error`.
pub error InvalidInput(problems: List[Problem])

## What is wrong with one field. `field` is the path to it: `title`, `body.title`, `tags[1]`.
pub type Problem(field: String, message: String) derive Eq, Show

type Route[E, R](
  method: Method,
  pattern: Pattern,
  input: Shape,
  run: fn(Request, List[(String, String)]) -> Response fails InvalidInput | E use R,
)

## The routes of an API, in the order they were added. E is what the handlers fail with, besides
## InvalidInput, and R the effects they use.
pub opaque type Api[E, R](routes: List[Route[E, R]])

## An API with no routes.
pub fn new[E, R]() -> Api[E, R] {
  Api(routes: [])
}

## Adds a route that answers `status` with the output of `f` as JSON. When two routes match
## a request, the one added first is taken.
pub fn route[I: Decode + Shaped, O: Encode, E, R](
  api: Api[E, R],
  method: Method,
  pattern: String,
  status: Int,
  f: fn(I) -> O fails InvalidInput | E use R,
) -> Api[E, R] {
  shape = Shape.of_parameter(f)
  run = fn(request: Request, params: List[(String, String)]) {
    input: I = read(shape, request, params)
    json(status, f(input))
  }
  add(api, method, pattern, shape, run)
}

## Adds a route whose handler returns nothing, answered with 204 and no body.
pub fn route_empty[I: Decode + Shaped, E, R](
  api: Api[E, R],
  method: Method,
  pattern: String,
  f: fn(I) -> () fails InvalidInput | E use R,
) -> Api[E, R] {
  shape = Shape.of_parameter(f)
  run = fn(request: Request, params: List[(String, String)]) {
    input: I = read(shape, request, params)
    f(input)
    Response.new(204, "")
  }
  add(api, method, pattern, shape, run)
}

## `route` with GET, answered with 200.
pub fn get[I: Decode + Shaped, O: Encode, E, R](
  api: Api[E, R],
  pattern: String,
  f: fn(I) -> O fails InvalidInput | E use R,
) -> Api[E, R] {
  route(api, Get, pattern, 200, f)
}

## `route` with POST, answered with 200. Use `route` for 201.
pub fn post[I: Decode + Shaped, O: Encode, E, R](
  api: Api[E, R],
  pattern: String,
  f: fn(I) -> O fails InvalidInput | E use R,
) -> Api[E, R] {
  route(api, Post, pattern, 200, f)
}

## `route` with PUT, answered with 200.
pub fn put[I: Decode + Shaped, O: Encode, E, R](
  api: Api[E, R],
  pattern: String,
  f: fn(I) -> O fails InvalidInput | E use R,
) -> Api[E, R] {
  route(api, Put, pattern, 200, f)
}

## `route` with PATCH, answered with 200.
pub fn patch[I: Decode + Shaped, O: Encode, E, R](
  api: Api[E, R],
  pattern: String,
  f: fn(I) -> O fails InvalidInput | E use R,
) -> Api[E, R] {
  route(api, Patch, pattern, 200, f)
}

## `route_empty` with DELETE, answered with 204.
pub fn delete[I: Decode + Shaped, E, R](
  api: Api[E, R],
  pattern: String,
  f: fn(I) -> () fails InvalidInput | E use R,
) -> Api[E, R] {
  route_empty(api, Delete, pattern, f)
}

## The response to `request`. The errors of the handlers are handed to `on_error`, which
## answers them; InvalidInput never reaches it.
pub fn handle[E, R](
  api: Api[E, R],
  request: Request,
  on_error: fn(fn() -> Response fails E use R) -> Response use R,
) -> Response use R {
  segments = request.segments()
  found = api.routes.filter_map(fn(r) {
    r.pattern.matches(segments).map(fn(params) { (r, params) })
  })
  method = request.method
  exact = found.find(fn((r, _)) { r.method == method })
  chosen = (exact, method) match {
    (None, Head) -> found.find(fn((r, _)) { r.method == Get })
    _            -> exact
  }
  if found.is_empty() {
    problem(404, "Not Found")
  } else {
    (chosen, method) match {
      (Some((r, params)), _) -> {
        response = on_error(fn() {
          run = r.run
          run(request, params) escape {
            InvalidInput(problems:) -> invalid(problems)
          }
        })
        if method == Head { Response(body: "", ..response) } else { response }
      }
      (None, Options) -> Response.new(204, "").add_header("allow", allow(found))
      (None, _)       -> problem(405, "Method Not Allowed").add_header("allow", allow(found))
    }
  }
}

## What is wrong with the routes of `api`, one line each: a parameter of a pattern that the input
## type has no field for, or an input type that is not a record. Call it from a test, as the
## routes are built again for each request.
pub fn check[E, R](api: Api[E, R]) -> List[String] {
  api.routes.flat_map(fn(r) {
    label = "#{method_name(r.method)} #{r.pattern.text}"
    if r.input.field_names().is_empty() && !r.pattern.names().is_empty() {
      ["#{label}: the input `#{r.input.name_of()}` is not a record with fields"]
    } else {
      r.pattern.names().filter(fn(name) { !Input.has_field(r.input, name) }).map(fn(name) {
        "#{label}: the input `#{r.input.name_of()}` has no field `#{name}`"
      })
    }
  })
}

## Reads the field `name` of the input into a value of the domain with `read`. A broken rule
## (`Broken`, `AllBroken`) or a failed parse (`ParseError`) becomes InvalidInput for that field;
## any other error passes through to `on_error`.
pub fn field[A, E](name: String, read: fn() -> A fails Broken | AllBroken | ParseError | E) -> A
  fails InvalidInput | E {
  read() escape {
    Broken(message:) -> fail InvalidInput(problems: [Problem(field: name, message:)])
    AllBroken(messages:) -> fail InvalidInput(
      problems: messages.map(fn(message) { Problem(field: name, message:) }),
    )
    ParseError(input:) -> fail InvalidInput(
      problems: [Problem(field: name, message: "cannot be read: `#{input}`")],
    )
  }
}

## `value` as JSON, with `content-type: application/json`.
pub fn json[A: Encode](status: Int, value: A) -> Response {
  Response.new(status, Json.encode(value)).add_header("content-type", "application/json")
}

## A problem response (RFC 9457) with `title`, in `application/problem+json`.
pub fn problem(status: Int, title: String) -> Response {
  problem_with(status, title, [])
}

## The 400 response for `problems`: a problem response with the problems under `errors`.
pub fn invalid(problems: List[Problem]) -> Response {
  errors = problems.map(fn(p) {
    Dynamic.object([("field", Dynamic.Text(p.field)), ("message", Dynamic.Text(p.message))])
  })
  problem_with(400, "Bad Request", [("errors", Dynamic.Items(errors))])
}

fn problem_with(status: Int, title: String, extra: List[(String, Dynamic)]) -> Response {
  fields = [("status", Encode.to_dynamic(status)), ("title", Dynamic.Text(title))]
  Response.new(status, Json.to_string(Dynamic.object(fields.append(extra)))).add_header(
    "content-type",
    "application/problem+json",
  )
}

fn add[E, R](
  api: Api[E, R],
  method: Method,
  pattern: String,
  input: Shape,
  run: fn(Request, List[(String, String)]) -> Response fails InvalidInput | E use R,
) -> Api[E, R] {
  route = Route(method:, pattern: Pattern.parse(pattern), input:, run:)
  Api(routes: api.routes.append([route]))
}

## The input of a route: the fields from the path and the query, and `body` from the JSON body if
## the input has that field, read with `from_dynamic_all`.
fn read[I: Decode](shape: Shape, request: Request, params: List[(String, String)]) -> I
  fails InvalidInput {
  body = if Input.has_field(shape, "body") {
    parsed = Json.parse(request.body) escape {
      SyntaxError(message:, offset: _) -> fail InvalidInput(
        problems: [Problem(field: "body", message: "is not JSON: #{message}")],
      )
    }
    [("body", parsed)]
  } else {
    []
  }
  fields = Input.fields(shape, params, request.query()).append(body)
  Decode.from_dynamic_all(Dynamic.object(fields)) escape {
    DecodeErrors(errors:) -> fail InvalidInput(problems: errors.map(problem_of))
  }
}

fn problem_of(e: DecodeError) -> Problem {
  field = e.path.fold(from: "", f: fn(acc, segment) {
    (acc, segment) match {
      ("", Key(key)) -> key
      (_, Key(key))  -> "#{acc}.#{key}"
      (_, Index(i))  -> "#{acc}[#{i}]"
    }
  })
  Problem(field:, message: "expected #{e.expected}, found #{e.actual.kind()}")
}

## The methods that the routes in `found` take, for `allow`: HEAD with GET, and OPTIONS.
fn allow[E, R](found: List[(Route[E, R], List[(String, String)])]) -> String {
  methods = found.map(fn((r, _)) { r.method })
  with_head = if methods.any(fn(m) { m == Get }) { methods.append([Head]) } else { methods }
  with_head.append([Options]).fold(from: [], f: fn(acc, m) {
    if acc.any(fn(n) { n == m }) { acc } else { acc.append([m]) }
  }).map(method_name).join(", ")
}

fn method_name(method: Method) -> String {
  method match {
    Get     -> "GET"
    Head    -> "HEAD"
    Post    -> "POST"
    Put     -> "PUT"
    Patch   -> "PATCH"
    Delete  -> "DELETE"
    Options -> "OPTIONS"
  }
}
